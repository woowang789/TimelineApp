# 타임라인 서비스 — MySQL 설정 (Phase 1 · P1-05)
#
# compose.yml 이 이 파일을 /etc/mysql/conf.d/zz-timeline.cnf 로 마운트한다.
# 파일명이 zz- 로 시작하는 이유: conf.d 는 사전 순으로 읽히고 뒤에 온 값이 이긴다.
# 이미지가 기본으로 넣어 두는 설정보다 항상 뒤에 오게 해서, 이미지 태그가 바뀌어도
# 여기 값이 조용히 덮여 쓰이지 않게 한다 (측정 재현성 — 마스터 §9.3).

[mysqld]

# -------------------------------------------------------------------------------------
# innodb_buffer_pool_size = 1G  ★ 마스터 §8 Phase 1 체크박스
# -------------------------------------------------------------------------------------
# Phase 0 까지는 기본값(128M)으로 뒀다. 여기서 1G 로 올린다.
#
# 왜 1G 인가 — 컨테이너 상한이 2G(§3 표)다. 버퍼 풀 외에 커넥션별 버퍼·redo·스레드 스택이
# 함께 들어가므로 상한의 절반이 실질 상한이다. 그리고 게시글을 500만이 아니라 300만으로 줄인 이유가
# "총 데이터가 버퍼 풀을 넘으면 측정치가 디스크 I/O 변동성에 지배당한다"(마스터 §8)이므로,
# 이 1G 는 데이터 크기 결정과 한 쌍이다. 임의로 올리면 그 결정의 근거가 사라진다.
#
# 판정 — 측정 중 버퍼 풀 히트율이 95% 미만이면 게시글 200만 하향 트리거가 발동한다(로드맵 §4.6, P1-10).
#   1 - (Innodb_buffer_pool_reads / Innodb_buffer_pool_read_requests)
innodb_buffer_pool_size = 1G


# -------------------------------------------------------------------------------------
# slow query log — 병목 판정 도구 (로드맵 §4.5 · P1-07 · P1-12)
# -------------------------------------------------------------------------------------
# long_query_time = 0.1 은 로드맵 P1-07 이 지정한 값이다. M0(인덱스 없음)에서는 Pull 쿼리가
# 거의 전부 걸리는데, 그게 목적이다 — "어떤 쿼리가 느린가"가 아니라 "얼마나 느린가"를 남긴다.
#
# dev 에도 켜 두는 이유: 이 프로파일에서 도는 것은 더미 적재와 수동 확인뿐이고,
# 적재 쪽은 multi-row INSERT 라 문장 수 자체가 적어 로그가 부풀지 않는다(3M 행 = 3천 문장).
# 프로파일마다 로그 설정이 다르면 "dev 에서 본 쿼리"와 "bench 에서 잰 쿼리"가 다른 조건이 되어
# 분석 근거로 못 쓴다. 조건을 하나로 두는 편이 낫다.
#
# 단, 고RPS 본 측정(P1-11/P1-14, 1,000 RPS × 5분)에서는 로그 기록 자체가 I/O 로 측정을 오염시킬 수 있다.
# 그 판단은 측정 프로토콜(P1-09 리허설)에서 하고, 필요하면 런타임에 끈다:
#   SET GLOBAL slow_query_log = OFF;   -- 재기동 없이 즉시 반영된다
slow_query_log          = 1
long_query_time         = 0.1
log_output              = FILE
# 데이터 볼륨 안에 둔다. mysqld 가 확실히 쓸 수 있는 유일한 디렉토리라서다
# (호스트 바인드 마운트는 uid 999 로 쓰기가 막히면 기동 자체가 실패한다).
# 스냅샷 아카이브에는 들어가지 않게 Makefile 의 db-snapshot 이 이 파일만 제외한다.
slow_query_log_file     = /var/lib/mysql/slow.log
# 인덱스를 안 탄 쿼리도 함께 남긴다 — M0 → M1 의 인덱스 도입 효과를 로그에서도 대조할 수 있다.
log_queries_not_using_indexes = 1
# 위 옵션을 켜면 작은 테이블 조회까지 전부 걸린다. 분당 상한을 둬 로그 폭주만 막는다.
log_throttle_queries_not_using_indexes = 60
